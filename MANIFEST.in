include README.md LICENSE THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md
recursive-include docs/releases *.md
recursive-include tests_release test_*.py
exclude docs/releases/v0.1.0-acceptance-plan.md
